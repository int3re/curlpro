From 4c207a65418401d59330de61ee1d423d66911c96 Mon Sep 17 00:00:00 2001
From: int3re <118649905+int3re@users.noreply.github.com>
Date: Thu, 8 Oct 2026 20:38:16 +0300
Subject: [PATCH 2/2] curlpro: the font inventory of the profile's device

FontCache::CreateFontPlatformData is where a CSS family name and a
local() source meet, so one filter there serves both. Brave filters
family matching alone; fpcapture measured eight families that local()
still resolves past such a filter. The last-resort fallback is never
filtered, and a profile without a font list changes nothing.
---
 .../renderer/platform/curlpro/fingerprint.cc  | 22 +++++++++++++++++++
 .../renderer/platform/curlpro/fingerprint.h   | 15 +++++++++++++
 .../platform/fonts/win/font_cache_skia_win.cc | 13 +++++++++++
 3 files changed, 50 insertions(+)

diff --git a/third_party/blink/renderer/platform/curlpro/fingerprint.cc b/third_party/blink/renderer/platform/curlpro/fingerprint.cc
index 1b7a986db7635..65725829a1d46 100644
--- a/third_party/blink/renderer/platform/curlpro/fingerprint.cc
+++ b/third_party/blink/renderer/platform/curlpro/fingerprint.cc
@@ -3,6 +3,8 @@
 #include "third_party/blink/renderer/platform/curlpro/fingerprint.h"
 
 #include <string_view>
+#include <utility>
+#include <vector>
 
 #include "base/command_line.h"
 #include "base/containers/span.h"
@@ -14,6 +16,7 @@
 // one header fewer to argue with checkdeps about.
 #include "third_party/blink/renderer/platform/wtf/text/base64.h"
 #include "third_party/blink/renderer/platform/wtf/text/string_view.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
 #include "third_party/blink/renderer/platform/wtf/vector.h"
 
 namespace blink::curlpro {
@@ -91,6 +94,18 @@ bool Fingerprint::Parse(const std::string& base64_json) {
   if (!profile) {
     return false;
   }
+  if (const base::DictValue* fonts = profile->FindDict("fonts")) {
+    if (const base::ListValue* present = fonts->FindList("present")) {
+      std::vector<std::string> lowered;
+      lowered.reserve(present->size());
+      for (const base::Value& family : *present) {
+        if (const std::string* name = family.GetIfString()) {
+          lowered.push_back(String::FromUtf8(*name).DeprecatedLower().Utf8());
+        }
+      }
+      fonts_ = base::flat_set<std::string>(std::move(lowered));
+    }
+  }
   if (const base::DictValue* webgl = profile->FindDict("webgl")) {
     webgl_unmasked_vendor_ = NonEmpty(*webgl, "unmasked_vendor");
     webgl_unmasked_renderer_ = NonEmpty(*webgl, "unmasked_renderer");
@@ -101,6 +116,13 @@ bool Fingerprint::Parse(const std::string& base64_json) {
   return true;
 }
 
+bool Fingerprint::FontAllowed(const AtomicString& family) const {
+  if (fonts_.empty() || family.empty()) {
+    return true;
+  }
+  return fonts_.contains(family.GetString().DeprecatedLower().Utf8());
+}
+
 int64_t Fingerprint::WebGLLimit(unsigned pname, bool webgl2, int64_t host) const {
   if (!active_) {
     return host;
diff --git a/third_party/blink/renderer/platform/curlpro/fingerprint.h b/third_party/blink/renderer/platform/curlpro/fingerprint.h
index acde7a103e585..c891bd26066d9 100644
--- a/third_party/blink/renderer/platform/curlpro/fingerprint.h
+++ b/third_party/blink/renderer/platform/curlpro/fingerprint.h
@@ -10,8 +10,10 @@
 #include <string>
 
 #include "base/containers/flat_map.h"
+#include "base/containers/flat_set.h"
 #include "base/no_destructor.h"
 #include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/atomic_string.h"
 
 namespace blink::curlpro {
 
@@ -52,6 +54,16 @@ class PLATFORM_EXPORT Fingerprint {
   // is the mark.
   int64_t WebGLLimit(unsigned pname, bool webgl2, int64_t host) const;
 
+  // Whether the profile's device has this font family. A profile without a
+  // font list allows every family, and the machine's own inventory answers.
+  //
+  // The list is a measured device's whole inventory, never a hand-made
+  // subset: it is served with its gaps, and a page that wants a script font
+  // the target lacks renders as it would render on the target. A subset
+  // invented by hand would take Chromium's fallback fonts away and leave
+  // glyphs unrendered, which is a louder signal than any font list.
+  bool FontAllowed(const AtomicString& family) const;
+
  private:
   friend class base::NoDestructor<Fingerprint>;
   Fingerprint();
@@ -62,6 +74,9 @@ class PLATFORM_EXPORT Fingerprint {
   std::optional<std::string> webgl_unmasked_renderer_;
   base::flat_map<unsigned, int64_t> webgl1_limits_;
   base::flat_map<unsigned, int64_t> webgl2_limits_;
+  // Lowered with String::DeprecatedLower, as the lookup lowers its argument:
+  // one folding on both sides, and Chromium matches families ignoring case.
+  base::flat_set<std::string> fonts_;
 };
 
 }  // namespace blink::curlpro
diff --git a/third_party/blink/renderer/platform/fonts/win/font_cache_skia_win.cc b/third_party/blink/renderer/platform/fonts/win/font_cache_skia_win.cc
index e00bd96c6e353..7bc7ec785b727 100644
--- a/third_party/blink/renderer/platform/fonts/win/font_cache_skia_win.cc
+++ b/third_party/blink/renderer/platform/fonts/win/font_cache_skia_win.cc
@@ -44,6 +44,7 @@
 #include "skia/ext/font_utils.h"
 #include "third_party/blink/public/platform/web_font_prewarmer.h"
 #include "third_party/blink/renderer/platform/fonts/bitmap_glyphs_block_list.h"
+#include "third_party/blink/renderer/platform/curlpro/fingerprint.h"
 #include "third_party/blink/renderer/platform/fonts/font_cache.h"
 #include "third_party/blink/renderer/platform/fonts/font_description.h"
 #include "third_party/blink/renderer/platform/fonts/font_face_creation_params.h"
@@ -411,6 +412,18 @@ const FontPlatformData* FontCache::CreateFontPlatformData(
   TRACE_EVENT0("ui", "FontCache::CreateFontPlatformData");
 
   DCHECK_EQ(creation_params.CreationType(), kCreateFontByFamily);
+
+  // curlPro: a family the profile's device does not have is absent here, and
+  // that is every path at once -- a CSS family name and a local() source both
+  // arrive in this function, and filtering family matching alone leaks
+  // through local() (measured: eight families). kLastResort is never
+  // filtered: it is Chromium's own fallback of last resort, and hiding it
+  // would leave glyphs unrendered rather than substituted.
+  if (alternate_font_name != AlternateFontName::kLastResort &&
+      !curlpro::Fingerprint::Get().FontAllowed(creation_params.Family())) {
+    return nullptr;
+  }
+
   sk_sp<SkTypeface> typeface;
 
   std::string name;
