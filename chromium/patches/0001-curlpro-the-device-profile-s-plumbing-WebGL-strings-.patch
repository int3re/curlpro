diff --git a/third_party/blink/renderer/platform/curlpro/fingerprint.cc b/third_party/blink/renderer/platform/curlpro/fingerprint.cc
new file mode 100644
index 0000000000000..1b7a986db7635
--- /dev/null
+++ b/third_party/blink/renderer/platform/curlpro/fingerprint.cc
@@ -0,0 +1,116 @@
+// Copyright 2026 The curlPro Authors. Licensed under the Apache License 2.0.
+
+#include "third_party/blink/renderer/platform/curlpro/fingerprint.h"
+
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+// Blink's own base64, not base/base64.h: platform's DEPS allow this one, and
+// one header fewer to argue with checkdeps about.
+#include "third_party/blink/renderer/platform/wtf/text/base64.h"
+#include "third_party/blink/renderer/platform/wtf/text/string_view.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink::curlpro {
+
+const char kFingerprintSwitch[] = "curlpro-fingerprint";
+
+namespace {
+
+// A block of {"name", "enum", "value"} entries, as scripts/fpcapture.py
+// writes them, into enum -> value. A malformed entry is skipped, not fatal:
+// the rest of the profile still describes the device.
+base::flat_map<unsigned, int64_t> Limits(const base::DictValue& webgl,
+                                         std::string_view key) {
+  base::flat_map<unsigned, int64_t> limits;
+  const base::ListValue* entries = webgl.FindList(key);
+  if (!entries) {
+    return limits;
+  }
+  for (const base::Value& entry : *entries) {
+    const base::DictValue* e = entry.GetIfDict();
+    if (!e) {
+      continue;
+    }
+    std::optional<int> pname = e->FindInt("enum");
+    // FindDouble reads integers too, and a limit such as WebGL2's
+    // MAX_ELEMENT_INDEX (2^32 - 2) is past what an int holds.
+    std::optional<double> value = e->FindDouble("value");
+    if (pname && value) {
+      limits[static_cast<unsigned>(*pname)] = static_cast<int64_t>(*value);
+    }
+  }
+  return limits;
+}
+
+std::optional<std::string> NonEmpty(const base::DictValue& d, std::string_view key) {
+  const std::string* s = d.FindString(key);
+  if (!s || s->empty()) {
+    return std::nullopt;
+  }
+  return *s;
+}
+
+}  // namespace
+
+// static
+const Fingerprint& Fingerprint::Get() {
+  static const base::NoDestructor<Fingerprint> instance;
+  return *instance;
+}
+
+Fingerprint::Fingerprint() {
+  const base::CommandLine& command_line = *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(kFingerprintSwitch)) {
+    return;
+  }
+  if (!Parse(command_line.GetSwitchValueASCII(kFingerprintSwitch))) {
+    // Reported, and then the machine's own values: a half-applied profile
+    // would be a device that exists nowhere.
+    LOG(ERROR) << "curlpro: --" << kFingerprintSwitch
+               << " is not a base64 JSON profile; reporting this machine";
+  }
+}
+
+bool Fingerprint::Parse(const std::string& base64_json) {
+  Vector<uint8_t> bytes;
+  if (!Base64Decode(StringView(base::as_byte_span(base64_json)), bytes,
+                    Base64DecodePolicy::kForgiving)) {
+    return false;
+  }
+  std::string json(bytes.begin(), bytes.end());
+  // JSON_PARSE_RFC: a profile is written by our own tool, so none of
+  // Chromium's extensions (comments, trailing commas) is wanted.
+  std::optional<base::DictValue> profile =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!profile) {
+    return false;
+  }
+  if (const base::DictValue* webgl = profile->FindDict("webgl")) {
+    webgl_unmasked_vendor_ = NonEmpty(*webgl, "unmasked_vendor");
+    webgl_unmasked_renderer_ = NonEmpty(*webgl, "unmasked_renderer");
+    webgl1_limits_ = Limits(*webgl, "parameters");
+    webgl2_limits_ = Limits(*webgl, "webgl2_parameters");
+  }
+  active_ = true;
+  return true;
+}
+
+int64_t Fingerprint::WebGLLimit(unsigned pname, bool webgl2, int64_t host) const {
+  if (!active_) {
+    return host;
+  }
+  const base::flat_map<unsigned, int64_t>& limits = webgl2 ? webgl2_limits_ : webgl1_limits_;
+  auto it = limits.find(pname);
+  if (it == limits.end() || it->second >= host) {
+    return host;
+  }
+  return it->second;
+}
+
+}  // namespace blink::curlpro
diff --git a/third_party/blink/renderer/platform/curlpro/fingerprint.h b/third_party/blink/renderer/platform/curlpro/fingerprint.h
new file mode 100644
index 0000000000000..acde7a103e585
--- /dev/null
+++ b/third_party/blink/renderer/platform/curlpro/fingerprint.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The curlPro Authors. Licensed under the Apache License 2.0.
+// Part of a patch set on Chromium; see chromium/DESIGN.md in the curlPro
+// repository for why each value is served where it is.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_CURLPRO_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_CURLPRO_FINGERPRINT_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/containers/flat_map.h"
+#include "base/no_destructor.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink::curlpro {
+
+// The switch the package's driver gives the browser and the browser forwards
+// to every renderer: base64 of the profile's compact JSON.
+PLATFORM_EXPORT extern const char kFingerprintSwitch[];
+
+// The device this renderer reports instead of the machine it runs on, read
+// once per process from kFingerprintSwitch. Without the switch, or with one
+// that does not parse, it is inactive and every accessor says so — the
+// browser then reports the machine, exactly as stock Chromium does.
+//
+// The rule (chromium/DESIGN.md): a measured device is served, and a
+// capability is never claimed beyond what this machine has. A limit is
+// therefore only ever lowered to the target's — see WebGLLimit.
+class PLATFORM_EXPORT Fingerprint {
+ public:
+  static const Fingerprint& Get();
+
+  Fingerprint(const Fingerprint&) = delete;
+  Fingerprint& operator=(const Fingerprint&) = delete;
+
+  bool active() const { return active_; }
+
+  // UNMASKED_VENDOR_WEBGL and UNMASKED_RENDERER_WEBGL, when the profile has
+  // them: measured, these are the only WebGL strings two real GPUs differ in.
+  const std::optional<std::string>& webgl_unmasked_vendor() const {
+    return webgl_unmasked_vendor_;
+  }
+  const std::optional<std::string>& webgl_unmasked_renderer() const {
+    return webgl_unmasked_renderer_;
+  }
+
+  // The value to report for a WebGL integer limit: the target's when the
+  // profile carries one *lower* than the machine's own `host` value, the
+  // host's otherwise. Raising a limit would claim a capability the GPU lacks;
+  // the first texture or shader that relies on it would break, and the break
+  // is the mark.
+  int64_t WebGLLimit(unsigned pname, bool webgl2, int64_t host) const;
+
+ private:
+  friend class base::NoDestructor<Fingerprint>;
+  Fingerprint();
+  bool Parse(const std::string& base64_json);
+
+  bool active_ = false;
+  std::optional<std::string> webgl_unmasked_vendor_;
+  std::optional<std::string> webgl_unmasked_renderer_;
+  base::flat_map<unsigned, int64_t> webgl1_limits_;
+  base::flat_map<unsigned, int64_t> webgl2_limits_;
+};
+
+}  // namespace blink::curlpro
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_CURLPRO_FINGERPRINT_H_
