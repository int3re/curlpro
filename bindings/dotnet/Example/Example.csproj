<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- dotnet build -p:CurlproTfm=net10.0 builds for another framework. -->
    <CurlproTfm Condition="'$(CurlproTfm)' == ''">net8.0</CurlproTfm>
    <TargetFramework>$(CurlproTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curlpro\Curlpro.csproj" />
  </ItemGroup>

</Project>
